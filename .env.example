# Conexión a Neon (Dashboard → Connect → copia la "connection string").
# Para probar sin Neon: DATABASE_URL=pglite:.pglite  (base local en la carpeta .pglite)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# URL pública de la app (se usa en los emails).
APP_URL=http://localhost:3000

# Código que deben ingresar tus conocidos para crear cuenta. Déjalo vacío para registro libre.
INVITE_CODE=

# Email de quien administra la app: ve /admin y recibe el resumen de tiendas que no se pudieron leer.
# Si lo dejas vacío, se usa SMTP_USER.
ADMIN_EMAIL=

# Secreto para el endpoint del cron. Genera uno con: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# Email por SMTP. Con Gmail: activa verificación en 2 pasos y crea una "contraseña de aplicación".
# Si lo dejas vacío, los avisos se muestran en la consola en vez de enviarse.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Alerta de ofertas <tu-correo@gmail.com>"
